# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env: 예시 파일만 커밋
!.env.example

# 계정 정보가 있는 로컬 전용 문서
CLAUDE_CODE_KIRO_HANDOFF.md
docs/local-setup.md

# 품질 검사 로그·캐시·상태, Playwright MCP 출력
.kiro/runs/
.playwright-mcp/

# 로컬 설치 파일·참고 자료
/*.exe
/KIRO Basic.*

# 시연용 복사본
/test/

# 잠자리채 로컬 저장소(작업·결과물·업로드)
/.data/

# 제출 템플릿(kirothon-starter) .gitignore에서 합친 항목
.venv/
venv/
__pycache__/
*.pyc
dist/
*.key
*.log
