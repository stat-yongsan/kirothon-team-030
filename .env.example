# 잠자리채 환경변수 예시. 모두 선택 항목이며, 비워 두면 기본값으로 동작한다.
# 복사해서 .env.local로 저장한다. .env.local은 git에 올라가지 않는다. NEXT_PUBLIC_ 접두사를 붙이지 말 것.

# 작업·결과물 저장 폴더. 비우면 ./.data/jamjarichae
JAMJARI_DATA_DIR=

# kiro-cli 실행 파일 경로. 비우면 PATH의 kiro-cli
JAMJARI_KIRO_BIN=

# kiro-cli 모델·추론 강도. 비우면 kiro-cli 기본값(Auto)
JAMJARI_KIRO_MODEL=
JAMJARI_KIRO_EFFORT=

# 작업당 kiro-cli 시간 상한(밀리초). 비우면 360000(6분)
JAMJARI_KIRO_TIMEOUT_MS=

# 아직 연결하지 않은 기능. 값이 없으면 화면에 "미연결"로 표시한다.
NOTION_TOKEN=
NOTION_ROOT_PAGE_ID=
GOOGLE_CLIENT_ID=
