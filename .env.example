# 복사해서 .env.local로 저장한 뒤 값을 채운다. .env.local은 git에 올라가지 않는다.
# Vercel에서는 프로젝트 Settings → Environment Variables에 같은 이름으로 넣는다(Preview/Production 구분).

# Anthropic API 키. 서버(Route Handler)에서만 읽는다. NEXT_PUBLIC_ 접두사를 붙이지 말 것.
ANTHROPIC_API_KEY=

# 앱이 호출할 Claude 모델 ID. 비우면 claude-opus-5-5. 실제 접근 가능 여부는 node scripts/check-api.mjs --live로 확인.
ANTHROPIC_MODEL=

# live 모드 보호용 접근 코드. 배포(next start·Vercel)에서 live면 필수 — 없으면 서버가 호출을 거부한다.
# 화면에서 처음 생성할 때 입력칸이 나타난다. 로컬 개발(npm.cmd run dev)에서는 비워도 된다.
DRAFT_ACCESS_CODE=

# mock = 고정 샘플 응답(화면에 "샘플 응답" 표시, API 미호출) / live = 실제 Claude 호출
AI_MODE=mock
